# Copy to .env, fill locally, then: set -a; source .env; set +a
# The bot does not load .env automatically.
# Set false to pause both daily delivery and member request processing.
BOT_ENABLED="true"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
TELEGRAM_USER_ID=""
# Required channel membership for /start and /report in private chats.
MEMBERSHIP_CHANNEL_ID="@sentencedIntoMusic"
# Optional for public channels; required invite link for private channels.
CHANNEL_JOIN_URL="https://t.me/sentencedIntoMusic"
OPENWEATHER_API_KEY=""
GROQ_API_KEY=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPORTRADAR_SOCCER_API_KEY=""
SPORTRADAR_BASKETBALL_API_KEY=""
TIMEZONE="Asia/Tehran"
CITY_NAME="مشهد"
WEATHER_LAT="36.2605"
WEATHER_LON="59.6168"
NEWS_MAX_AGE_HOURS="36"
NEWS_PER_CATEGORY="2"
GROQ_MODELS="openai/gpt-oss-120b,llama-3.3-70b-versatile"
ENABLE_AUDIO_DOWNLOAD="false"

ENABLE_PERSIAN_CALENDAR="true"
ENABLE_PERSIAN_POETRY="true"

ENABLE_VOCABULARY="true"
ENABLE_VOCABULARY_DICTIONARY="true"
VOCABULARY_PER_DAY="5"
